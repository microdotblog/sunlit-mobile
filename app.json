{
  "expo": {
    "name": "Sunlit",
    "slug": "sunlit",
    "version": "1.0.0",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "sunlit",
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-image",
      "expo-video",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "android": {
      "package": "blog.micro.sunlit",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#FFFDE8"
      }
    },
    "ios": {
      "bundleIdentifier": "blog.micro.sunlit",
      "supportsTablet": true
    }
  }
}
