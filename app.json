{
  "expo": {
    "name": "Sunlit",
    "slug": "sunlit",
    "version": "1.0.0",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "sunlit",
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-image",
      "expo-video",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withBackupDisabled"
    ],
    "android": {
      "package": "blog.micro.sunlit",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#FFFDE8"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "blog.micro.sunlit",
      "supportsTablet": true
    }
  }
}
