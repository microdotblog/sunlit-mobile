{
  "expo": {
    "name": "Sunlit",
    "slug": "sunlit",
    "version": "1.0.0",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "sunlit",
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-image",
      "expo-video",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withBackupDisabled",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sunlit uses your location to find nearby places when you check in.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*",
            "video/*",
            "text/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*"
          ],
          "disableIOS": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0099FF",
          "defaultChannel": "default"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SunlitPhotos",
              "label": "Sunlit",
              "description": "Photos from your timeline or Discover",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "520dp",
              "maxResizeHeight": "520dp",
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "android": {
      "package": "blog.micro.sunlit",
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#FFFDE8"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "blog.micro.sunlit",
      "supportsTablet": true
    }
  }
}
